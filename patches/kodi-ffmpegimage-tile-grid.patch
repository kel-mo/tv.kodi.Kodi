From 03f98bb57230ef12221c9755fbb045f91b306523 Mon Sep 17 00:00:00 2001
From: Kel Modderman <kelvmod@gmail.com>
Date: Sat, 17 Oct 2026 17:05:57 +1000
Subject: [PATCH 4/4] FFmpegImage: Apply the rotation of tile grids

The irot and imir transforms of a grid belong to the grid, not to its
tiles. FFmpeg exports them as a display matrix in the coded side data
of the stream group, so attach it to the composited frame and read the
orientation as for other images.

This needs libavformat 61.9.100, first released in FFmpeg 8.0. With
older versions, rotated grids show without rotation.

Assisted-by: Claude
---
 xbmc/guilib/FFmpegImage.cpp | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/xbmc/guilib/FFmpegImage.cpp b/xbmc/guilib/FFmpegImage.cpp
index f69543d78a..e12079d3e8 100644
--- a/xbmc/guilib/FFmpegImage.cpp
+++ b/xbmc/guilib/FFmpegImage.cpp
@@ -19,6 +19,7 @@
 #include <array>
 #include <cmath>
 #include <cstdint>
+#include <cstring>
 
 extern "C"
 {
@@ -602,6 +603,17 @@ AVFrame* CFFmpegImage::ExtractTileGridFrame()
     return nullptr;
   }
 
+#if LIBAVFORMAT_VERSION_INT >= AV_VERSION_INT(61, 9, 100)
+  // irot/imir of a grid apply to the grid, not its tiles
+  const AVPacketSideData* sideData{av_packet_side_data_get(
+      grid->coded_side_data, grid->nb_coded_side_data, AV_PKT_DATA_DISPLAYMATRIX)};
+  AVFrameSideData* matrix{
+      sideData ? av_frame_new_side_data(canvas, AV_FRAME_DATA_DISPLAYMATRIX, sideData->size)
+               : nullptr};
+  if (matrix)
+    std::memcpy(matrix->data, sideData->data, sideData->size);
+#endif
+
   return canvas;
 }
 
