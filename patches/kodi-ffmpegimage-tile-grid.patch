From 4d8865d7883f34b80b0f344ece060e8fe15db96e Mon Sep 17 00:00:00 2001
From: Kel Modderman <kelvmod@gmail.com>
Date: Sat, 17 Oct 2026 17:05:56 +1000
Subject: [PATCH 1/4] FFmpegImage: Decode the primary video stream

Initialize used the first stream of the file, and ExtractFrame passed
the packets of all streams to its decoder. HEIF files carry thumbnails
and auxiliary images as further streams, so an iPhone photo with its
thumbnail first in the file decoded as garbage.

Use the video stream that FFmpeg marks as default, which is the primary
item of a HEIF or AVIF file, else the first video stream, and skip the
packets of other streams.

Files whose first stream is not video, such as an MP4 with the audio
track first, now decode their video instead of failing.

Assisted-by: Claude
---
 xbmc/guilib/FFmpegImage.cpp | 34 +++++++++++++++++++++++++++++-----
 xbmc/guilib/FFmpegImage.h   |  1 +
 2 files changed, 30 insertions(+), 5 deletions(-)

diff --git a/xbmc/guilib/FFmpegImage.cpp b/xbmc/guilib/FFmpegImage.cpp
index 78b9e14711..2d1a1d9267 100644
--- a/xbmc/guilib/FFmpegImage.cpp
+++ b/xbmc/guilib/FFmpegImage.cpp
@@ -292,7 +292,23 @@ bool CFFmpegImage::Initialize(unsigned char* buffer, size_t bufSize)
     FreeIOCtx(&m_ioctx);
     return false;
   }
-  AVCodecParameters* codec_params = m_fctx->streams[0]->codecpar;
+
+  // prefer the primary picture of HEIF and AVIF, else the first video stream
+  int primary{-1};
+  int firstVideo{-1};
+  for (unsigned int i = 0; i < m_fctx->nb_streams && primary < 0; ++i)
+  {
+    const AVStream* stream = m_fctx->streams[i];
+    if (stream->codecpar->codec_type != AVMEDIA_TYPE_VIDEO)
+      continue;
+    if (firstVideo < 0)
+      firstVideo = static_cast<int>(i);
+    if (stream->disposition & AV_DISPOSITION_DEFAULT)
+      primary = static_cast<int>(i);
+  }
+  m_streamIndex = primary >= 0 ? primary : std::max(firstVideo, 0);
+
+  AVCodecParameters* codec_params = m_fctx->streams[m_streamIndex]->codecpar;
   const AVCodec* codec = avcodec_find_decoder(codec_params->codec_id);
   m_codec_ctx = avcodec_alloc_context3(codec);
   if (!m_codec_ctx)
@@ -323,7 +339,7 @@ bool CFFmpegImage::Initialize(unsigned char* buffer, size_t bufSize)
 
 AVFrame* CFFmpegImage::ExtractFrame()
 {
-  if (!m_fctx || !m_fctx->streams[0])
+  if (!m_fctx || !m_fctx->streams[m_streamIndex])
   {
     CLog::LogF(LOGERROR, "No valid format context or stream");
     return nullptr;
@@ -347,6 +363,14 @@ AVFrame* CFFmpegImage::ExtractFrame()
       return nullptr;
     }
 
+    // HEIF thumbnails and auxiliary images come as further streams
+    if (pkt.stream_index != m_streamIndex)
+    {
+      av_packet_unref(&pkt);
+      ret = AVERROR(EAGAIN);
+      continue;
+    }
+
     ret = DecodeFFmpegFrame(m_codec_ctx, frame, &frame_decoded, &pkt);
   }
   if (ret < 0 || frame_decoded == 0 || !frame)
@@ -359,11 +383,11 @@ AVFrame* CFFmpegImage::ExtractFrame()
   //we need milliseconds
 
 #if LIBAVCODEC_VERSION_MAJOR < 60
-  frame->pkt_duration =
-      av_rescale_q(frame->pkt_duration, m_fctx->streams[0]->time_base, AVRational{1, 1000});
+  frame->pkt_duration = av_rescale_q(frame->pkt_duration, m_fctx->streams[m_streamIndex]->time_base,
+                                     AVRational{1, 1000});
 #else
   frame->duration =
-      av_rescale_q(frame->duration, m_fctx->streams[0]->time_base, AVRational{1, 1000});
+      av_rescale_q(frame->duration, m_fctx->streams[m_streamIndex]->time_base, AVRational{1, 1000});
 #endif
 
   m_height = frame->height;
diff --git a/xbmc/guilib/FFmpegImage.h b/xbmc/guilib/FFmpegImage.h
index c53280a001..92cf8d8da6 100644
--- a/xbmc/guilib/FFmpegImage.h
+++ b/xbmc/guilib/FFmpegImage.h
@@ -94,6 +94,7 @@ private:
   AVIOContext* m_ioctx = nullptr;
   AVFormatContext* m_fctx = nullptr;
   AVCodecContext* m_codec_ctx = nullptr;
+  int m_streamIndex = 0;
 
   AVFrame* m_pFrame;
   uint8_t* m_outputBuffer;

From 4643ef44188c316922d3f0c8801308166c752488 Mon Sep 17 00:00:00 2001
From: Kel Modderman <kelvmod@gmail.com>
Date: Sat, 17 Oct 2026 17:05:57 +1000
Subject: [PATCH 2/4] FFmpegImage: Split frame decoding from the frame
 properties

Move the packet loop of ExtractFrame into ExtractStreamFrame, so that
another source of frames can share the size, alpha and orientation
handling. No change in behaviour. Two lines over the column limit are
re-wrapped, as clang-format requires for moved lines.

Assisted-by: Claude
---
