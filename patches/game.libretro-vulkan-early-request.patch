From 31ab91822cd634a416678083210916d2d9f00551 Mon Sep 17 00:00:00 2001
From: Kel Modderman <kelvmod@gmail.com>
Date: Sun, 15 Nov 2026 08:18:44 +1000
Subject: [PATCH] Make a Vulkan context asked for in retro_init() at load

Kodi has no streams to render to until the game is opened, so it
refuses a hardware context asked for in retro_init(), as rpcs3 does.
Keep a Vulkan request refused that early and make it again when the
game loads. If Kodi refuses it then too, the load fails, because the
core can't fall back any more.

Assisted-by: Claude
---
 src/client.cpp                       |  6 +++++-
 src/libretro/LibretroEnvironment.cpp | 29 +++++++++++++++++++++++++++-
 src/libretro/LibretroEnvironment.h   |  8 +++++++-
 3 files changed, 40 insertions(+), 3 deletions(-)

diff --git a/src/client.cpp b/src/client.cpp
index 325ab5b..64d29a7 100644
--- a/src/client.cpp
+++ b/src/client.cpp
@@ -300,7 +300,11 @@ bool CGameLibRetro::LoadGameInternal(const retro_game_info* gameInfo)
 {
   auto& environment = CLibretroEnvironment::Get();
   CCheevos::Get().Deinitialize();
-  environment.ResetLoadState();
+  if (!environment.ResetLoadState())
+  {
+    environment.CloseStreams();
+    return false;
+  }
   m_memory.BeginContent();
 
   // A core missing its BIOS usually just fails to load, so watch what it looks for
diff --git a/src/libretro/LibretroEnvironment.cpp b/src/libretro/LibretroEnvironment.cpp
index b441e55..deda457 100644
--- a/src/libretro/LibretroEnvironment.cpp
+++ b/src/libretro/LibretroEnvironment.cpp
@@ -130,6 +130,8 @@ void CLibretroEnvironment::Deinitialize()
     std::lock_guard<std::mutex> lock(m_heldSettingsMutex);
     m_heldSettings.clear();
   }
+  m_earlyVulkan.reset();
+  m_gameLoading = false;
   VulkanBridge().Reset();
   m_addon = nullptr;
   m_client = nullptr;
@@ -152,10 +154,24 @@ void CLibretroEnvironment::CloseStreams()
     m_addon->EnableHardwareRendering({});
 }
 
-void CLibretroEnvironment::ResetLoadState()
+bool CLibretroEnvironment::ResetLoadState()
 {
   CloseStreams();
   InitializeStreams();
+  m_gameLoading = true;
+
+  if (!m_earlyVulkan)
+    return true;
+
+  // The core was told yes before load and can't fall back now
+  m_clientBridge->SetHwContextReset(m_earlyVulkanReset);
+  m_clientBridge->SetHwContextDestroy(m_earlyVulkanDestroy);
+  if (!m_videoStream.EnableHardwareRendering() || !m_addon->EnableHardwareRendering(*m_earlyVulkan))
+  {
+    kodi::Log(ADDON_LOG_ERROR, "Vulkan bridge: Kodi refused the context at load too");
+    return false;
+  }
+  return true;
 }
 
 void CLibretroEnvironment::UpdateVideoGeometry(const retro_game_geometry &geometry,
@@ -378,6 +394,17 @@ bool CLibretroEnvironment::EnvironmentCallback(unsigned int cmd, void *data)
         // Now that hooks are installed, enable HW rendering in the frontend
         if (!m_addon->EnableHardwareRendering(hw_info))
         {
+          // Kodi has no streams before the game opens, so keep a Vulkan request
+          // made from retro_init() and make it at load
+          if (VulkanBridge().IsRequested() && !m_gameLoading)
+          {
+            m_earlyVulkan = hw_info;
+            m_earlyVulkanReset = typedData->context_reset;
+            m_earlyVulkanDestroy = typedData->context_destroy;
+            kodi::Log(ADDON_LOG_DEBUG, "Vulkan bridge: context asked for before load, kept for it");
+            break;
+          }
+
           VulkanBridge().Reset();
           // The frontend cannot render this context type on the display stack
           // it has. Returning false leaves the core to fall back to software,
diff --git a/src/libretro/LibretroEnvironment.h b/src/libretro/LibretroEnvironment.h
index b9cc264..0ea39ce 100644
--- a/src/libretro/LibretroEnvironment.h
+++ b/src/libretro/LibretroEnvironment.h
@@ -56,7 +56,7 @@ namespace LIBRETRO
     CAudioTiming& AudioTiming(void) { return m_audioTiming; }
 
     void InitializeStreams();
-    void ResetLoadState();
+    bool ResetLoadState();
     void CloseStreams();
 
     /*!
@@ -153,5 +153,11 @@ namespace LIBRETRO
 
     std::map<std::string, std::string> m_heldSettings;
     std::mutex m_heldSettingsMutex;
+
+    // A Vulkan context asked for before the game opens, made again at load
+    std::optional<game_hw_rendering_properties> m_earlyVulkan;
+    void (*m_earlyVulkanReset)(void) = nullptr;
+    void (*m_earlyVulkanDestroy)(void) = nullptr;
+    bool m_gameLoading = false;
   };
 } // namespace LIBRETRO
-- 
