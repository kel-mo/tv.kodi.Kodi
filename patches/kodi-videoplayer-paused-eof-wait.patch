From 04c51cbc2d28ed5e86b9b7a2b07fc8c8db435606 Mon Sep 17 00:00:00 2001
From: Kel Modderman <kelvmod@gmail.com>
Date: Sat, 14 Nov 2026 15:05:28 +1000
Subject: [PATCH] Don't spin a core when paused near the end of a file

Paused in the last seconds of a file, the demuxer has read to the end
before the queues are full, so CVideoPlayer::Process() gets no packet
and goes straight round again for as long as the pause lasts. Wait
10 ms there, as the loop already does when the queues are full.

Assisted-by: Claude
---
 xbmc/cores/VideoPlayer/VideoPlayer.cpp | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/xbmc/cores/VideoPlayer/VideoPlayer.cpp b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
index 4e02a05c5d..e12a1919e8 100644
--- a/xbmc/cores/VideoPlayer/VideoPlayer.cpp
+++ b/xbmc/cores/VideoPlayer/VideoPlayer.cpp
@@ -1788,7 +1788,10 @@ void CVideoPlayer::Process()
     {
       // when paused, demuxer could be be returning empty
       if (m_playSpeed == DVD_PLAYSPEED_PAUSE)
+      {
+        CThread::Sleep(10ms);
         continue;
+      }
 
       // check for a still frame state
       if (std::shared_ptr<CDVDInputStream::IMenus> pStream = std::dynamic_pointer_cast<CDVDInputStream::IMenus>(m_pInputStream))
-- 
