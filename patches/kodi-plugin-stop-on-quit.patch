From c18df4023c204e80bd87d670a96dcfb293c75783 Mon Sep 17 00:00:00 2001
From: Kel Modderman <kelvmod@gmail.com>
Date: Mon, 16 Nov 2026 06:21:06 +1000
Subject: [PATCH] [addons] Stop a plugin's script when Kodi quits during its
 call

A plugin call made off the GUI thread, for example to fill a list
control, waits for its script in CScriptRunner::WaitOnScriptResult().
Nothing ends that wait when Kodi quits, and CJobManager::CancelJobs()
waits for the job, so the quit takes as long as the script does
(#30577). If the script is showing a modal dialog, which only the main
thread can close, Kodi never exits.

End the wait once the application is stopping, and stop the script the
way a cancelled call already does.

Assisted-by: Claude
---
 xbmc/interfaces/generic/ScriptRunner.cpp | 13 +++++++++----
 1 file changed, 9 insertions(+), 4 deletions(-)

diff --git a/xbmc/interfaces/generic/ScriptRunner.cpp b/xbmc/interfaces/generic/ScriptRunner.cpp
index 82cccf59de..edbd7f3ea4 100644
--- a/xbmc/interfaces/generic/ScriptRunner.cpp
+++ b/xbmc/interfaces/generic/ScriptRunner.cpp
@@ -10,6 +10,7 @@
 
 #include "ServiceBroker.h"
 #include "URL.h"
+#include "application/Application.h"
 #include "dialogs/GUIDialogBusy.h"
 #include "dialogs/GUIDialogProgress.h"
 #include "guilib/GUIComponent.h"
@@ -139,15 +140,19 @@ bool CScriptRunner::WaitOnScriptResult(int scriptId,
   else
   {
     // wait for the script to finish or be cancelled
-    while (!IsCancelled() && CScriptInvocationManager::GetInstance().IsRunning(scriptId) &&
-           !m_scriptDone.Wait(20ms))
+    while (!IsCancelled() && !g_application.IsStopping() &&
+           CScriptInvocationManager::GetInstance().IsRunning(scriptId) && !m_scriptDone.Wait(20ms))
       ;
 
     // give the script 30 seconds to exit before we attempt to stop it
     XbmcThreads::EndTime<> timer(30s);
-    while (!timer.IsTimePast() && CScriptInvocationManager::GetInstance().IsRunning(scriptId) &&
-           !m_scriptDone.Wait(20ms))
+    while (!timer.IsTimePast() && !g_application.IsStopping() &&
+           CScriptInvocationManager::GetInstance().IsRunning(scriptId) && !m_scriptDone.Wait(20ms))
       ;
+
+    // when Kodi quits the job manager waits for this thread, so stop the script now
+    if (g_application.IsStopping() && CScriptInvocationManager::GetInstance().IsRunning(scriptId))
+      cancelled = true;
   }
 
   if (cancelled || IsCancelled())
-- 
