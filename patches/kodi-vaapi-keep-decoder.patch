From e1b7ff06513a32f18e94d1f02780cc35cbc81b21 Mon Sep 17 00:00:00 2001
From: Kel Modderman <kelvmod@gmail.com>
Date: Sun, 15 Nov 2026 02:49:04 +1000
Subject: [PATCH] VAAPI: keep the decoder when FFmpeg asks for the format again

FFmpeg calls get_format again for every new SPS, even when only its HRD
parameters changed. Some streams carry two SPS with the same id in each
IDR access unit that differ only there, so VAAPI was closed and opened
again at every IDR, which shows as flicker and green frames.

Let a hardware decoder carry on when nothing it was opened with has
changed.

Assisted-by: Claude
---
 .../DVDCodecs/Video/DVDVideoCodec.h           |  1 +
 .../DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp   | 10 +++++++++
 .../VideoPlayer/DVDCodecs/Video/VAAPI.cpp     | 21 ++++++++++++++++++-
 .../cores/VideoPlayer/DVDCodecs/Video/VAAPI.h |  5 +++++
 4 files changed, 36 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.h
index 7d43876174..195e057cd3 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodec.h
@@ -276,6 +276,7 @@ public:
   IHardwareDecoder() = default;
   ~IHardwareDecoder() override = default;
   virtual bool Open(AVCodecContext* avctx, AVCodecContext* mainctx, const enum AVPixelFormat) = 0;
+  virtual bool Reuse(AVCodecContext* avctx, const enum AVPixelFormat fmt) { return false; }
   virtual CDVDVideoCodec::VCReturn Decode(AVCodecContext* avctx, AVFrame* frame) = 0;
   virtual bool GetPicture(AVCodecContext* avctx, VideoPicture* picture) = 0;
   virtual CDVDVideoCodec::VCReturn Check(AVCodecContext* avctx) = 0;
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
index d3a2af4297..84b2adadd9 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/DVDVideoCodecFFmpeg.cpp
@@ -273,6 +273,16 @@ enum AVPixelFormat CDVDVideoCodecFFmpeg::GetFormat(struct AVCodecContext * avctx
     return defaultFmt;
   }
 
+  // FFmpeg asks again on every SPS change, even if the decoder could carry on
+  if (ctx->HasHardware())
+  {
+    for (const AVPixelFormat* cur = fmt; *cur != AV_PIX_FMT_NONE; cur++)
+    {
+      if (ctx->m_pHardware->Reuse(avctx, *cur))
+        return *cur;
+    }
+  }
+
   // hardware decoder de-selected, restore standard ffmpeg
   if (ctx->HasHardware())
   {
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/VAAPI.cpp b/xbmc/cores/VideoPlayer/DVDCodecs/Video/VAAPI.cpp
index a177cd1659..b5a7d75879 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/VAAPI.cpp
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/VAAPI.cpp
@@ -788,13 +788,31 @@ bool CDecoder::Open(AVCodecContext* avctx, AVCodecContext* mainctx, const enum A
   framesCtx->width  = avctx->coded_width;
   framesCtx->height = avctx->coded_height;
 
-  avctx->hw_frames_ctx = framesRef;
+  m_framesRef.reset(framesRef);
+  avctx->hw_frames_ctx = av_buffer_ref(framesRef);
+  m_swFormat = avctx->pix_fmt;
+  m_profile = avctx->profile;
+  m_refs = avctx->refs;
   avctx->get_buffer2 = CDecoder::FFGetBuffer;
   avctx->slice_flags = SLICE_FLAG_CODED_ORDER|SLICE_FLAG_ALLOW_FIELD;
 
   return true;
 }
 
+bool CDecoder::Reuse(AVCodecContext* avctx, const enum AVPixelFormat fmt)
+{
+  if (fmt != AV_PIX_FMT_VAAPI || !m_vaapiConfigured || m_DisplayState != VAAPI_OPEN ||
+      avctx->pix_fmt != m_swFormat || avctx->profile != m_profile || avctx->refs != m_refs ||
+      avctx->coded_width != m_vaapiConfig.surfaceWidth ||
+      avctx->coded_height != m_vaapiConfig.surfaceHeight ||
+      avctx->width != m_vaapiConfig.vidWidth || avctx->height != m_vaapiConfig.vidHeight ||
+      av_cmp_q(avctx->sample_aspect_ratio, m_vaapiConfig.aspect) != 0)
+    return false;
+
+  avctx->hw_frames_ctx = av_buffer_ref(m_framesRef.get());
+  return true;
+}
+
 void CDecoder::Close()
 {
   CLog::Log(LOGINFO, "VAAPI::{}", __FUNCTION__);
@@ -803,6 +821,7 @@ void CDecoder::Close()
 
   FiniVAAPIOutput();
 
+  m_framesRef.reset();
   m_deviceRef.reset();
 
   if (m_vaapiConfig.context)
diff --git a/xbmc/cores/VideoPlayer/DVDCodecs/Video/VAAPI.h b/xbmc/cores/VideoPlayer/DVDCodecs/Video/VAAPI.h
index 93cd546283..824291fcb8 100644
--- a/xbmc/cores/VideoPlayer/DVDCodecs/Video/VAAPI.h
+++ b/xbmc/cores/VideoPlayer/DVDCodecs/Video/VAAPI.h
@@ -547,6 +547,7 @@ public:
   ~CDecoder() override;
 
   bool Open (AVCodecContext* avctx, AVCodecContext* mainctx, const enum AVPixelFormat) override;
+  bool Reuse(AVCodecContext* avctx, const enum AVPixelFormat fmt) override;
   CDVDVideoCodec::VCReturn Decode (AVCodecContext* avctx, AVFrame* frame) override;
   bool GetPicture(AVCodecContext* avctx, VideoPicture* picture) override;
   void Reset() override;
@@ -612,6 +613,10 @@ private:
   };
 
   std::unique_ptr<AVBufferRef, AVBufferRefDeleter> m_deviceRef;
+  std::unique_ptr<AVBufferRef, AVBufferRefDeleter> m_framesRef;
+  AVPixelFormat m_swFormat{AV_PIX_FMT_NONE};
+  int m_profile{AV_PROFILE_UNKNOWN};
+  int m_refs{0};
 };
 
 //-----------------------------------------------------------------------------
