From 1c376f8a087f84ccc46e33779e3e0e56880732f0 Mon Sep 17 00:00:00 2001
From: Kel Modderman <kelvmod@gmail.com>
Date: Thu, 1 Oct 2026 15:36:57 +1000
Subject: [PATCH] [guilib] Allow textures to keep subpixel positions
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

CGUITexture rounds every corner of a texture to a whole pixel. That keeps
static artwork crisp, but slow zoom and slide animations then move in
one-pixel steps, which shows as judder on large screens, e.g. a slow
Ken Burns pan in a picture add-on.

Add an opt-in subpixel="true" texture attribute that skips the rounding
of the screen x and y coordinates. Depth stays rounded, and textures
without the attribute render exactly as before.

GLES rounds the corners in its vertex shader since the quads moved to
the GPU, so m_snap is set to 2 for a subpixel texture to skip the
rounding there as well.

Assisted-By: Claude
Co-authored-by: Clément Péron <peron.clem@gmail.com>
---
 system/shaders/GLES/2.0/gles_shader.vert   | 14 ++++++++----
 xbmc/guilib/GUIControlFactory.cpp          |  2 ++
 xbmc/guilib/GUIImage.dox                   |  2 ++
 xbmc/guilib/GUITexture.cpp                 | 20 ++++++++++++-----
 xbmc/guilib/GUITexture.h                   |  8 +++++++
 xbmc/guilib/GUITextureGLES.cpp             |  2 +-
 xbmc/guilib/test/CMakeLists.txt            |  1 +
 xbmc/guilib/test/TestGUIControlFactory.cpp | 22 +++++++++++++++++++
 xbmc/guilib/test/TestGUITexture.cpp        | 25 ++++++++++++++++++++++
 9 files changed, 86 insertions(+), 10 deletions(-)
 create mode 100644 xbmc/guilib/test/TestGUITexture.cpp

diff --git a/system/shaders/GLES/2.0/gles_shader.vert b/system/shaders/GLES/2.0/gles_shader.vert
index e5119fd033..9a7c2213bd 100644
--- a/system/shaders/GLES/2.0/gles_shader.vert
+++ b/system/shaders/GLES/2.0/gles_shader.vert
@@ -57,12 +57,18 @@ void main ()
     cord0 = vec4(m_attrcord0.xy + (m_texSwap.x > 0.0 ? t.yx : t) * (m_attrcord0.zw - m_attrcord0.xy), 0.0, 1.0);
     cord1 = vec4(m_attrcord1.xy + (m_texSwap.y > 0.0 ? t.yx : t) * (m_attrcord1.zw - m_attrcord1.xy), 0.0, 1.0);
 
-    // Round to whole pixels. A bottom corner is pushed one pixel away from the opposite corner if
-    // both round to the same row or column, so that thin quads never vanish.
+    // Round to whole pixels, unless m_snap is 2 for a texture that keeps subpixel positions (then
+    // only the depth is rounded). A bottom corner is pushed one pixel away from the opposite corner
+    // if both land on the same row or column, so that thin quads never vanish.
     float push = (p.y > q.y && all(notEqual(pc, qc))) ? 1.0 : 0.0;
     pos = m_gui * vec4(pc, 0.0, 1.0);
-    pos.xyz = floor(pos.xyz + 0.5);
-    vec2 opposite = floor((m_gui * vec4(qc, 0.0, 1.0)).xy + 0.5);
+    vec2 opposite = (m_gui * vec4(qc, 0.0, 1.0)).xy;
+    if (m_snap < 1.5)
+    {
+      pos.xy = floor(pos.xy + 0.5);
+      opposite = floor(opposite + 0.5);
+    }
+    pos.z = floor(pos.z + 0.5);
     pos.xy += vec2(equal(pos.xy, opposite)) * push;
   }
   else
diff --git a/xbmc/guilib/GUIControlFactory.cpp b/xbmc/guilib/GUIControlFactory.cpp
index 0ae1c69ff7..3fdddfb921 100644
--- a/xbmc/guilib/GUIControlFactory.cpp
+++ b/xbmc/guilib/GUIControlFactory.cpp
@@ -447,6 +447,8 @@ bool CGUIControlFactory::GetTexture(const TiXmlNode* pRootNode,
   const char* background = pNode->Attribute("background");
   if (background && StringUtils::CompareNoCase(background, "true", 4) == 0)
     image.useLarge = true;
+  const char* subpixel = pNode->Attribute("subpixel");
+  image.m_subpixel = subpixel && StringUtils::CompareNoCase(subpixel, "true") == 0;
   image.filename = pNode->FirstChild() ? pNode->FirstChild()->Value() : "";
   return true;
 }
diff --git a/xbmc/guilib/GUIImage.dox b/xbmc/guilib/GUIImage.dox
index b4c80d7a0d..568d76c465 100644
--- a/xbmc/guilib/GUIImage.dox
+++ b/xbmc/guilib/GUIImage.dox
@@ -87,10 +87,12 @@ For the tags "texture" and "bordertexture", the following attributes are availab
 | background    | Used on the <b>`<imagepath>`</b> tag. When set to "true", this forces the image to be loaded via the large texture manager (except for textures located in Textures.xbt).
 | diffuse       | Specifies a diffuse texture which is "modulated" or multiplied with the texture in order to give specific effects, such as making the image gain transparency, or tint it in various ways. As it's applied per-pixel many effects are possible, the most popular being by a transparent reflection which slowly gets more and more opaque. This is achieved using a WHITE image where the transparency increases as you move down the texture.
 | colordiffuse  | This specifies the color to be used for the texture basis. It's is specified in hexadecimal notation using the AARRGGBB format. If you define <b>`<texture colordiffuse="FFFFAAFF">texture.png</texture>`</b> (magenta), the image will be given a magenta tint when rendered. You can also specify this as a name from the colour theme, or you can also use $VAR and $INFO for dynamic values.
+| subpixel      | When set to "true", the texture keeps its fractional screen position instead of being snapped to whole pixels, so slow zoom and slide animations move smoothly rather than in one pixel steps. Best suited to photos and artwork that move; edges and 1 pixel lines are softer when the position is fractional, and labels drawn over the texture still snap to whole pixels. Defaults to "false".
 
 @skinning_v20 <b>infill</b> New texture attribute added.
 @skinning_v22 <b>imagefilter</b> New tag added.
 @skinning_v22 <b>diffusefilter</b> New tag added.
+@skinning_v23 <b>subpixel</b> New texture attribute added.
 
 --------------------------------------------------------------------------------
 \section Image_Control_sect4 See also
diff --git a/xbmc/guilib/GUITexture.cpp b/xbmc/guilib/GUITexture.cpp
index 9bb19b115d..ec72cc34a0 100644
--- a/xbmc/guilib/GUITexture.cpp
+++ b/xbmc/guilib/GUITexture.cpp
@@ -353,6 +353,13 @@ void CGUITexture::UpdateSegments()
   }
 }
 
+float CGUITexture::SnapToPixel(float coord, bool subpixel)
+{
+  if (subpixel)
+    return coord;
+  return static_cast<float>(MathUtils::round_int(static_cast<double>(coord)));
+}
+
 void CGUITexture::Render(const Segment& segment)
 {
   CRect diffuse(segment.texture);
@@ -368,20 +375,23 @@ void CGUITexture::Render(const Segment& segment)
 
   float x[4], y[4], z[4];
 
-#define ROUND_TO_PIXEL(x) static_cast<float>(MathUtils::round_int(static_cast<double>(x)))
+#define ROUND_TO_PIXEL(x) SnapToPixel((x), m_info.m_subpixel)
+#define ROUND_DEPTH(x) SnapToPixel((x), false)
 
+  // clang-format off
   x[0] = ROUND_TO_PIXEL(CServiceBroker::GetWinSystem()->GetGfxContext().ScaleFinalXCoord(vertex.x1, vertex.y1));
   y[0] = ROUND_TO_PIXEL(CServiceBroker::GetWinSystem()->GetGfxContext().ScaleFinalYCoord(vertex.x1, vertex.y1));
-  z[0] = ROUND_TO_PIXEL(CServiceBroker::GetWinSystem()->GetGfxContext().ScaleFinalZCoord(vertex.x1, vertex.y1));
+  z[0] = ROUND_DEPTH(CServiceBroker::GetWinSystem()->GetGfxContext().ScaleFinalZCoord(vertex.x1, vertex.y1));
   x[1] = ROUND_TO_PIXEL(CServiceBroker::GetWinSystem()->GetGfxContext().ScaleFinalXCoord(vertex.x2, vertex.y1));
   y[1] = ROUND_TO_PIXEL(CServiceBroker::GetWinSystem()->GetGfxContext().ScaleFinalYCoord(vertex.x2, vertex.y1));
-  z[1] = ROUND_TO_PIXEL(CServiceBroker::GetWinSystem()->GetGfxContext().ScaleFinalZCoord(vertex.x2, vertex.y1));
+  z[1] = ROUND_DEPTH(CServiceBroker::GetWinSystem()->GetGfxContext().ScaleFinalZCoord(vertex.x2, vertex.y1));
   x[2] = ROUND_TO_PIXEL(CServiceBroker::GetWinSystem()->GetGfxContext().ScaleFinalXCoord(vertex.x2, vertex.y2));
   y[2] = ROUND_TO_PIXEL(CServiceBroker::GetWinSystem()->GetGfxContext().ScaleFinalYCoord(vertex.x2, vertex.y2));
-  z[2] = ROUND_TO_PIXEL(CServiceBroker::GetWinSystem()->GetGfxContext().ScaleFinalZCoord(vertex.x2, vertex.y2));
+  z[2] = ROUND_DEPTH(CServiceBroker::GetWinSystem()->GetGfxContext().ScaleFinalZCoord(vertex.x2, vertex.y2));
   x[3] = ROUND_TO_PIXEL(CServiceBroker::GetWinSystem()->GetGfxContext().ScaleFinalXCoord(vertex.x1, vertex.y2));
   y[3] = ROUND_TO_PIXEL(CServiceBroker::GetWinSystem()->GetGfxContext().ScaleFinalYCoord(vertex.x1, vertex.y2));
-  z[3] = ROUND_TO_PIXEL(CServiceBroker::GetWinSystem()->GetGfxContext().ScaleFinalZCoord(vertex.x1, vertex.y2));
+  z[3] = ROUND_DEPTH(CServiceBroker::GetWinSystem()->GetGfxContext().ScaleFinalZCoord(vertex.x1, vertex.y2));
+  // clang-format on
 
   if (y[2] == y[0]) y[2] += 1.0f;
   if (x[2] == x[0]) x[2] += 1.0f;
diff --git a/xbmc/guilib/GUITexture.h b/xbmc/guilib/GUITexture.h
index 1f2ba002f6..a0224e9595 100644
--- a/xbmc/guilib/GUITexture.h
+++ b/xbmc/guilib/GUITexture.h
@@ -45,6 +45,7 @@ public:
   CRect      border;          // scaled  - unneeded if we get rid of scale on load
   bool m_infill{
       true}; // if false, the main body of a texture is not drawn. useful for borders with no inner filling
+  bool m_subpixel{false}; // if true, corners are not snapped to whole pixels, for smooth motion
   int        orientation;     // orientation of the texture (0 - 7 == EXIForientation - 1)
   std::string diffuse;         // diffuse overlay texture
   KODI::GUILIB::GUIINFO::CGUIInfoColor diffuseColor; // diffuse color
@@ -75,6 +76,13 @@ public:
       float posX, float posY, float width, float height, const CTextureInfo& texture);
   virtual CGUITexture* Clone() const = 0;
 
+  /*! \brief Screen coordinate of a texture corner.
+   \param coord the unsnapped screen coordinate
+   \param subpixel whether the texture keeps its fractional position
+   \return coord rounded to a whole pixel, or unchanged if subpixel
+   */
+  static float SnapToPixel(float coord, bool subpixel);
+
   static void DrawQuad(const CRect& coords,
                        KODI::UTILS::COLOR::Color color,
                        CTexture* texture = nullptr,
diff --git a/xbmc/guilib/GUITextureGLES.cpp b/xbmc/guilib/GUITextureGLES.cpp
index 72fb15f557..84de720677 100644
--- a/xbmc/guilib/GUITextureGLES.cpp
+++ b/xbmc/guilib/GUITextureGLES.cpp
@@ -256,7 +256,7 @@ bool CGUITextureGLES::DrawQuads(const std::vector<Quad>& quads,
   glUniform2f(m_renderSystem->GUIShaderGetTexSwap(), swap0, swap1);
   glUniformMatrix4fv(m_renderSystem->GUIShaderGetGUIMatrix(), 1, GL_FALSE,
                      CMatrixGL(context.GetGUIMatrix()));
-  glUniform1f(m_renderSystem->GUIShaderGetSnap(), 1.0f);
+  glUniform1f(m_renderSystem->GUIShaderGetSnap(), m_info.m_subpixel ? 2.0f : 1.0f);
 
   m_quadBuffer.Bind();
   const auto attribute = [](GLint location, std::size_t member)
