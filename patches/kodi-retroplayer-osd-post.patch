From 835b8e33fc0e139156136cebc37a160138ff443d Mon Sep 17 00:00:00 2001
From: Kel Modderman <kelvmod@gmail.com>
Date: Tue, 10 Nov 2026 08:14:50 +1000
Subject: [PATCH] [RetroPlayer] Don't wait for the game OSD to close when
 pausing

A pause sent with SendMsg(TMSG_MEDIA_PAUSE), like JSON-RPC
Player.PlayPause, waits for the app thread to handle it. Pausing a game
opens the game OSD, which is modal, so the sender got no reply until
someone closed the OSD.

Post the OSD's activation instead, as CDialogGameIndicators does, so
the pause returns straight away.

Assisted-by: Claude
---
 xbmc/cores/RetroPlayer/RetroPlayer.cpp | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/xbmc/cores/RetroPlayer/RetroPlayer.cpp b/xbmc/cores/RetroPlayer/RetroPlayer.cpp
index 27585cd46d..7c706ab4cd 100644
--- a/xbmc/cores/RetroPlayer/RetroPlayer.cpp
+++ b/xbmc/cores/RetroPlayer/RetroPlayer.cpp
@@ -791,7 +791,8 @@ void CRetroPlayer::ResetPlayback()
 
 void CRetroPlayer::OpenOSD()
 {
-  CServiceBroker::GetGUI()->GetWindowManager().ActivateWindow(WINDOW_DIALOG_GAME_OSD);
+  // Posted, as the OSD is modal and a pause can come in a message its sender waits on
+  CServiceBroker::GetAppMessenger()->PostMsg(TMSG_GUI_ACTIVATE_WINDOW, WINDOW_DIALOG_GAME_OSD, 0);
 }
 
 void CRetroPlayer::CloseOSD()
