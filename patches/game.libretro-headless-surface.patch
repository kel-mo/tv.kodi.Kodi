+bool CVulkanBridge::HasHeadlessSurface()
+{
+  uint32_t count = 0;
+  if (!m_vk->EnumerateInstanceExtensionProperties ||
+      m_vk->EnumerateInstanceExtensionProperties(nullptr, &count, nullptr) != VK_SUCCESS)
+    return false;
+  std::vector<VkExtensionProperties> extensions(count);
+  m_vk->EnumerateInstanceExtensionProperties(nullptr, &count, extensions.data());
+  return std::all_of(std::begin(SURFACE_EXTENSIONS), std::end(SURFACE_EXTENSIONS),
+                     [&](const char* name)
+                     {
+                       return std::any_of(extensions.begin(), extensions.end(),
+                                          [name](const VkExtensionProperties& extension)
+                                          { return std::strcmp(extension.extensionName, name) == 0; });
+                     });
+}
