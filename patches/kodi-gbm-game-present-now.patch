From 02a497b3a341f629d2449b04e4a97148013f6ead Mon Sep 17 00:00:00 2001
From: Chris <meischris39@hotmail.com>
Date: Sat, 3 Oct 2026 13:22:43 +0100
Subject: [PATCH] [gbm] Present without queuing ahead while a game is full
 screen

Since the EGL fences of #23921, GBM renders a frame, waits for the
previous one to reach the screen and only then commits the new one
without blocking, so every frame is shown a vblank after the one it
could have been. That buys render throughput, which was the point, and
costs a frame of latency, which a game feels on every press.

The fullscreen game window now asks the window system for low latency
presentation, and GBM commits the frame it has just rendered and waits
for it instead. Measured on a Radeon 780M at 60 Hz with a Mega Drive
game: a game frame took 32.8 ms from being drawn into the GUI to the
page flip, and now takes 16.3 ms, still at a steady 60 fps.
---
 .../RetroPlayer/guiwindows/GameWindowFullScreen.cpp   |  4 ++++
 xbmc/windowing/WinSystem.h                            | 11 +++++++++++
 xbmc/windowing/gbm/WinSystemGbmGLContext.cpp          |  3 ++-
 xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp        |  3 ++-
 4 files changed, 19 insertions(+), 2 deletions(-)

diff --git a/xbmc/cores/RetroPlayer/guiwindows/GameWindowFullScreen.cpp b/xbmc/cores/RetroPlayer/guiwindows/GameWindowFullScreen.cpp
index b68e2a5a9b..67ac0dca33 100644
--- a/xbmc/cores/RetroPlayer/guiwindows/GameWindowFullScreen.cpp
+++ b/xbmc/cores/RetroPlayer/guiwindows/GameWindowFullScreen.cpp
@@ -181,6 +181,8 @@ void CGameWindowFullScreen::OnInitWindow()
   // Switch resolution
   CServiceBroker::GetWinSystem()->GetGfxContext().SetFullScreenVideo(true); //! @todo
 
+  CServiceBroker::GetWinSystem()->SetLowLatencyPresentation(true);
+
   CGUIWindow::OnInitWindow();
 
   GAME::CDialogGameIndicators::SetOverGame(true);
@@ -213,6 +215,8 @@ void CGameWindowFullScreen::OnDeinitWindow(int nextWindowID)
 
   CGUIWindow::OnDeinitWindow(nextWindowID);
 
+  CServiceBroker::GetWinSystem()->SetLowLatencyPresentation(false);
+
   CServiceBroker::GetWinSystem()->GetGfxContext().SetFullScreenVideo(false); //! @todo
 }
 
diff --git a/xbmc/windowing/WinSystem.h b/xbmc/windowing/WinSystem.h
index ebd9ef130f..b7c00204b6 100644
--- a/xbmc/windowing/WinSystem.h
+++ b/xbmc/windowing/WinSystem.h
@@ -19,6 +19,7 @@
 #include "utils/DisplayInfo.h"
 #include "utils/HDRCapabilities.h"
 
+#include <atomic>
 #include <memory>
 #include <string>
 #include <vector>
@@ -125,6 +126,15 @@ public:
    */
   virtual float GetFrameLatencyAdjustment() { return 0.0; }
 
+  /*!
+   * \brief Prefer the shortest time to the screen over render throughput
+   *
+   * Set while a game is shown full screen, where the delay between a press and
+   * its picture is felt. A window system that queues frames ahead of the
+   * display stops doing so while this is set.
+   */
+  void SetLowLatencyPresentation(bool lowLatency) { m_lowLatencyPresentation = lowLatency; }
+
   virtual bool Minimize() { return false; }
   virtual bool Restore() { return false; }
   virtual bool Hide() { return false; }
@@ -377,4 +387,5 @@ protected:
   std::unique_ptr<IWinEvents> m_winEvents;
   std::unique_ptr<CGraphicContext> m_gfxContext;
   std::shared_ptr<CDPMSSupport> m_dpms;
+  std::atomic<bool> m_lowLatencyPresentation{false};
 };
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLContext.cpp
index d6c7afb3a3..f0b67d78f9 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLContext.cpp
@@ -124,7 +124,8 @@ void CWinSystemGbmGLContext::PresentRender(bool rendered, bool videoLayer)
 
   if (rendered || videoLayer)
   {
-    bool async = !videoLayer && m_eglFence;
+    // A frame committed without waiting reaches the screen a vblank later
+    bool async = !videoLayer && m_eglFence && !m_lowLatencyPresentation;
     if (rendered)
     {
 #if defined(EGL_ANDROID_native_fence_sync) && defined(EGL_KHR_fence_sync)
diff --git a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
index b3eb401fde..410feccd8c 100644
--- a/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
+++ b/xbmc/windowing/gbm/WinSystemGbmGLESContext.cpp
@@ -141,7 +141,8 @@ void CWinSystemGbmGLESContext::PresentRender(bool rendered, bool videoLayer)
 
   if (rendered || videoLayer)
   {
-    bool async = !videoLayer && m_eglFence;
+    // A frame committed without waiting reaches the screen a vblank later
+    bool async = !videoLayer && m_eglFence && !m_lowLatencyPresentation;
     if (rendered)
     {
 #if defined(EGL_ANDROID_native_fence_sync) && defined(EGL_KHR_fence_sync)
