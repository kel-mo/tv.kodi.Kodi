{
    "name": "game.libretro.swanstation",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPACKAGE_ZIP=ON",
        "-DCMAKE_INSTALL_PREFIX=/app/lib/kodi/addons",
        "-DCMAKE_PREFIX_PATH=/app"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.swanstation",
            "commit": "3a181b75fc8677ea3e20a50971e55b892893ec3c"
        },
        {
            "type": "file",
            "path": "../../tools/gen-addon-metainfo.sh"
        }
    ],
    "modules": [
        {
            "name": "libretro-swanstation",
            "buildsystem": "cmake-ninja",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release"
            ],
            "no-make-install": true,
            "post-install": [
                "install -s -D -m 755 swanstation_libretro.so /app/lib/libretro/swanstation_libretro.so"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/swanstation/archive/e436e9b85374def58d211df7f78880f0f4a917b4.tar.gz",
                    "sha256": "bff59f88ed83dbc9f597ccd52b29dc82eae2c724f5158095ef075cccb430131a"
                }
            ]
        }
    ],
    "post-install": [
        "bash $FLATPAK_BUILDER_BUILDDIR/gen-addon-metainfo.sh game.libretro.swanstation"
    ]
}
