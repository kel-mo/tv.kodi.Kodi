                    "sha256": "a7da357d6eea94b5b88c0cbb8d6d55980d027af34eac96fcd88496ec11202852"
                }
            ]
        }
    ],
    "post-install": [
        "bash $FLATPAK_BUILDER_BUILDDIR/gen-addon-metainfo.sh game.libretro.swanstation"
    ]
}
