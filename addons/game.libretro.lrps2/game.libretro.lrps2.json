{
    "name": "game.libretro.lrps2",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPACKAGE_ZIP=ON",
        "-DCMAKE_INSTALL_PREFIX=/app/lib/kodi/addons",
        "-DCMAKE_PREFIX_PATH=/app"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.lrps2",
            "commit": "2a88a13ad88a5bb9f5a841ab01c57b87c1977f95"
        },
        {
            "type": "patch",
            "path": "game.libretro.lrps2-001-drop-unbuilt-renderers.patch"
        },
        {
            "type": "file",
            "path": "../../tools/gen-addon-metainfo.sh"
        }
    ],
    "modules": [
        {
            "name": "libretro-lrps2",
            "buildsystem": "cmake-ninja",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0 -D_GNU_SOURCE",
                "cxxflags": "-g0"
            },
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DPACKAGE_MODE=ON",
                "-DBIN_DIR=lib/libretro",
                "-DUSE_VULKAN=OFF"
            ],
            "builddir": true,
            "post-install": [
                "strip /app/lib/libretro/pcsx2_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/ps2/archive/63258042588c72ca7c79f1a70f3fc77f4d6201a7.tar.gz",
                    "sha256": "ca35ddb022d179537a0a86be5ab80b8d9bb9ff8484836884f1a56e9ec592fb22"
                }
            ]
        }
    ],
    "post-install": [
        "bash $FLATPAK_BUILDER_BUILDDIR/gen-addon-metainfo.sh game.libretro.lrps2"
    ]
}
