{
    "name": "game.libretro.lrps2",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPACKAGE_ZIP=ON",
        "-DCMAKE_INSTALL_PREFIX=/app/lib/kodi/addons",
        "-DCMAKE_PREFIX_PATH=/app"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.lrps2",
            "commit": "72d79336faa99c145ac612b3a97726a5c78cbf15"
        },
        {
            "type": "patch",
            "path": "game.libretro.lrps2-001-drop-unbuilt-renderers.patch"
        },
        {
            "type": "file",
            "path": "../../tools/gen-addon-metainfo.sh"
        }
    ],
    "modules": [
        {
            "name": "libretro-lrps2",
            "buildsystem": "cmake-ninja",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0 -D_GNU_SOURCE",
                "cxxflags": "-g0"
            },
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DPACKAGE_MODE=ON",
                "-DBIN_DIR=lib/libretro",
                "-DUSE_VULKAN=OFF"
            ],
            "builddir": true,
            "post-install": [
                "strip /app/lib/libretro/pcsx2_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/ps2/archive/03f12e66b58fba32d40f8bb8d3069b603e0551b5.tar.gz",
                    "sha256": "6508651712501e70b4b932ce0acdbf753c8bce8cc0bd496a9b0e735bb0ce226d"
                }
            ]
        }
    ],
    "post-install": [
        "bash $FLATPAK_BUILDER_BUILDDIR/gen-addon-metainfo.sh game.libretro.lrps2"
    ]
}
