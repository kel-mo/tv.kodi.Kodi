{
    "name": "game.libretro.rpcs3",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPACKAGE_ZIP=ON",
        "-DCMAKE_INSTALL_PREFIX=/app/lib/kodi/addons",
        "-DCMAKE_PREFIX_PATH=/app"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kel-mo/game.libretro.rpcs3",
            "commit": "756e203ad6e2c8b89834764a023fa5db23eac6bd"
        },
        {
            "type": "file",
            "path": "../../tools/gen-addon-metainfo.sh"
        }
    ],
    "modules": [
        {
            "name": "glew",
            "buildsystem": "cmake-ninja",
            "subdir": "build/cmake",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
                "-DBUILD_SHARED_LIBS=OFF",
                "-DBUILD_UTILS=OFF",
                "-DCMAKE_POSITION_INDEPENDENT_CODE=ON",
                "-DCMAKE_INSTALL_LIBDIR=lib"
            ],
            "cleanup": [
                "/include/GL/glew.h",
                "/include/GL/glxew.h",
                "/include/GL/wglew.h",
                "/include/GL/eglew.h",
                "/lib/libGLEW.a",
                "/lib/cmake/glew",
                "/lib/pkgconfig/glew.pc"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/nigels-com/glew/releases/download/glew-2.2.0/glew-2.2.0.tgz",
                    "sha256": "d4fc82893cfb00109578d0a1a2337fb8ca335b3ceccf97b97e5cc7f08e4353e1"
                }
            ]
        },
        {
            "name": "libretro-rpcs3",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0 -DGLEW_NO_GLU",
                "cxxflags": "-g0 -DGLEW_NO_GLU",
                "append-path": "/usr/lib/sdk/llvm22/bin",
                "append-ld-library-path": "/usr/lib/sdk/llvm22/lib",
                "ldflags": "-fuse-ld=lld",
                "env": {
                    "CC": "clang",
                    "CXX": "clang++",
                    "AR": "llvm-ar",
                    "RANLIB": "llvm-ranlib"
                }
            },
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DCMAKE_POLICY_VERSION_MINIMUM=3.5",
                "-DCMAKE_PREFIX_PATH=/app",
                "-DBUILD_SHARED_LIBS=OFF",
                "-DUSE_NATIVE_INSTRUCTIONS=OFF",
                "-DUSE_PRECOMPILED_HEADERS=OFF",
                "-DBUILD_LLVM=OFF",
                "-DSTATIC_LINK_LLVM=OFF",
                "-DLLVM_DIR=/usr/lib/sdk/llvm22/lib/cmake/llvm",
                "-DUSE_SDL=OFF",
                "-DUSE_FAUDIO=OFF",
                "-DUSE_LIBEVDEV=OFF",
                "-DUSE_DISCORD_RPC=OFF",
                "-DUSE_SYSTEM_CURL=ON",
                "-DUSE_SYSTEM_LIBPNG=ON",
                "-DUSE_SYSTEM_ZLIB=ON",
                "-DUSE_SYSTEM_ZSTD=ON",
                "-DUSE_SYSTEM_PUGIXML=ON",
                "-DUSE_SYSTEM_LIBUSB=ON",
                "-DUSE_SYSTEM_FFMPEG=ON",
                "-DOpenGL_GL_PREFERENCE=LEGACY",
                "-DCMAKE_DISABLE_FIND_PACKAGE_Wayland=ON",
                "-DGLEW_USE_STATIC_LIBS=ON",
                "-Wno-dev"
            ],
            "make-args": [
                "rpcs3_libretro"
            ],
            "no-make-install": true,
            "post-install": [
                "install -Dm755 \"$(find . -path '*/rpcs3/libretro/rpcs3_libretro.so' -print -quit)\" /app/lib/libretro/rpcs3_libretro.so",
                "llvm-strip /app/lib/libretro/rpcs3_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/WizzardSK/rpcs3-libretro/archive/74b3fa37beb294418230b1f039bab4de97f18479.tar.gz",
                    "sha256": "993ae42512bd45765a9cf2835c49628b1aaec56f3d16fc0a60d204fc800164f3"
                },
                {
                    "type": "archive",
                    "url": "https://github.com/asmjit/asmjit/archive/416f7356967c1f66784dc1580fe157f9406d8bff.tar.gz",
                    "sha256": "de254de095aff47cb3b07c73f7ed7e0e86e2b10ca5518cd8e7fdf9d7d1a4c707",
                    "dest": "3rdparty/asmjit/asmjit"
                },
                {
                    "type": "archive",
                    "url": "https://github.com/KhronosGroup/glslang/archive/f0bd0257c308b9a26562c1a30c4748a0219cc951.tar.gz",
                    "sha256": "bd58dca4dac67dcf7640292d7d63e0416274d40ee2200f7301878cec11ac6647",
                    "dest": "3rdparty/glslang/glslang"
                },
                {
                    "type": "archive",
                    "url": "https://github.com/RPCS3/yaml-cpp/archive/51a5d623e3fde1f58829a56ba910f1cb33596222.tar.gz",
                    "sha256": "20a60c92049f8c2449effbe3abe17aab4ca4159cdc2ab829ea6624676a2fe66a",
                    "dest": "3rdparty/yaml-cpp/yaml-cpp"
                },
                {
                    "type": "archive",
                    "url": "https://github.com/wolfSSL/wolfssl/archive/3c5eead44904df64e6a5a1f4ebdce377d35a849a.tar.gz",
                    "sha256": "20fceb75ecac0fdb241f6d683e8cd1b579db0297f6d506d13eca9656262d72a5",
                    "dest": "3rdparty/wolfssl/wolfssl"
                },
                {
                    "type": "archive",
                    "url": "https://github.com/RPCS3/soundtouch/archive/a0fba77b6f9cfbdb71f8bbec58b6ac4e5e3b1097.tar.gz",
                    "sha256": "4337ccfb874da5a3f9eeb8d68a589464fbe3a8151df1818ee8934b4534cf6f50",
                    "dest": "3rdparty/SoundTouch/soundtouch"
                },
                {
                    "type": "archive",
                    "url": "https://github.com/miniupnp/miniupnp/archive/d66872e34d9ff83a07f8b71371b13419b2089953.tar.gz",
                    "sha256": "83eb848b067a5e84582018cf8c3c7f283738e5eb47a8f148a05b41f433134166",
                    "dest": "3rdparty/miniupnp/miniupnp"
                },
                {
                    "type": "archive",
                    "url": "https://github.com/thestk/rtmidi/archive/1e5b49925aa60065db52de44c366d446a902547b.tar.gz",
                    "sha256": "c5090c14edb3e3f82dd63589041f516bb24b78091aa82574fdc17d33ee62361e",
                    "dest": "3rdparty/rtmidi/rtmidi"
                },
                {
                    "type": "archive",
                    "url": "https://github.com/nothings/stb/archive/013ac3beddff3dbffafd5177e7972067cd2b5083.tar.gz",
                    "sha256": "b01aa93e1a968aed55f43e072c98ee401d2f20e897aabdb1a166c7166886ed11",
                    "dest": "3rdparty/stblib/stb"
                },
                {
                    "type": "archive",
                    "url": "https://github.com/xioTechnologies/Fusion/archive/9325424011892abacc0ce42b8bb1a8ae20264b9b.tar.gz",
                    "sha256": "71ea11ef44b6533580213efea3dd7441db99c76b27ddd25abb5aeed89565f61f",
                    "dest": "3rdparty/fusion/fusion"
                },
                {
                    "type": "archive",
                    "url": "https://github.com/GPUOpen-LibrariesAndSDKs/VulkanMemoryAllocator/archive/3aa921224c154a0d2c43912bc88e1c42ce1f7607.tar.gz",
                    "sha256": "5935dc47d8659bb681f1b7218f903ec171d10c39509752fd64eb2c9daf601ced",
                    "dest": "3rdparty/GPUOpen/VulkanMemoryAllocator"
                },
                {
                    "type": "archive",
                    "url": "https://github.com/protocolbuffers/protobuf/archive/edaa823d8b36a8656d7b2b9241b7d0bfe50af878.tar.gz",
                    "sha256": "a54e2dd9b137f07bdaec0748b7948b0c41859893a9acc63fcb3a514db5f1e609",
                    "dest": "3rdparty/protobuf/protobuf"
                },
                {
                    "type": "patch",
                    "path": "libretro-rpcs3-001-enable-cellaudio-buffering.patch"
                }
            ]
        }
    ],
    "post-install": [
        "bash $FLATPAK_BUILDER_BUILDDIR/gen-addon-metainfo.sh game.libretro.rpcs3"
    ]
}
