{
    "name": "game.libretro.ppsspp",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPACKAGE_ZIP=ON",
        "-DCMAKE_INSTALL_PREFIX=/app/lib/kodi/addons",
        "-DCMAKE_PREFIX_PATH=/app"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.ppsspp",
            "commit": "14b5532e1ffb52070fd0685ee8fecff9f092d8ac"
        },
        {
            "type": "file",
            "path": "../../tools/gen-addon-metainfo.sh"
        }
    ],
    "modules": [
        {
            "name": "libretro-ppsspp",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0",
                "ldflags": "-Wl,--push-state,--no-as-needed -lGLESv2 -lEGL -Wl,--pop-state"
            },
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DLIBRETRO=ON",
                "-DUSING_GLES2=ON",
                "-DUSING_X11_VULKAN=OFF",
                "-DUSE_WAYLAND_WSI=OFF",
                "-DUSE_SYSTEM_ZSTD=ON",
                "-DUSE_SYSTEM_FFMPEG=ON",
                "-DFFMPEG_DIR=/app",
                "-DARMIPS_USE_STD_FILESYSTEM=ON"
            ],
            "make-args": [
                "ppsspp_libretro"
            ],
            "no-make-install": true,
            "post-install": [
                "install -s -D -m 755 \"$(find . -name ppsspp_libretro.so -print -quit)\" /app/lib/libretro/ppsspp_libretro.so",
                "mkdir -p /app/lib/libretro/PPSSPP",
                "cd $FLATPAK_BUILDER_BUILDDIR/assets && cp -a compat.ini compatvr.ini langregion.ini infra-dns.json adhoc-servers.json redump.csv ppge_atlas.zim ppge_atlas.meta flash0 lang shaders /app/lib/libretro/PPSSPP/",
                "install -m 644 $FLATPAK_BUILDER_BUILDDIR/LICENSE.TXT /app/lib/libretro/PPSSPP/LICENSE.TXT"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/hrydgard/ppsspp/archive/9416bbcab0d7a3a9ce3674f250c2b31f72b4ebfa.tar.gz",
                    "sha256": "09a1c7b7dd9887a76719df12fa880ef8c4e5b8d7a37959c7bd98c4ea4425ff73"
                },
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/libretro-common/archive/4ed412f88fedd38750c898f75178b4f7d15274fb.tar.gz",
                    "sha256": "4d4e8be52a3022b82c9170bf5cea78ad6c3309d4f23d15b6390432b6452c8f54",
                    "dest": "libretro/libretro-common"
                },
                {
                    "type": "archive",
                    "url": "https://github.com/Kingcom/armips/archive/62adab4ef30da765f5cf22a451eb08a59c54dc8b.tar.gz",
                    "sha256": "f7a65102febb4811a336a06e6d93c7e84cc86548182d54e1b1b4e2bffe562f56",
                    "dest": "ext/armips"
                },
