                    "sha256": "f91007ec5cd5380184678cb282353a6b97b6ba2278ef4911e217472186a31762",
                    "dest": "ext/OpenXR-SDK"
                },
                {
                    "type": "archive",
                    "url": "https://github.com/Tencent/rapidjson/archive/73063f5002612c6bf64fe24f851cd5cc0d83eef9.tar.gz",
                    "sha256": "896eb817fb2bc62a0a84ca65fac3e3c385b410e6dbf70d69c411e25776663e39",
                    "dest": "ext/rapidjson"
                }
            ]
        }
    ],
    "post-install": [
        "rm -rf /app/lib/kodi/addons/game.libretro.ppsspp/resources/system/PPSSPP",
        "mv /app/lib/libretro/PPSSPP /app/lib/kodi/addons/game.libretro.ppsspp/resources/system/PPSSPP",
        "bash $FLATPAK_BUILDER_BUILDDIR/gen-addon-metainfo.sh game.libretro.ppsspp"
    ]
}
