{
    "name": "game.libretro.flycast",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPACKAGE_ZIP=ON",
        "-DCMAKE_INSTALL_PREFIX=/app/lib/kodi/addons",
        "-DCMAKE_PREFIX_PATH=/app"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.flycast",
            "commit": "e71b89f3f7bcf9425512a1882fe92630f170e07a"
        },
        {
            "type": "file",
            "path": "../../tools/gen-addon-metainfo.sh"
        }
    ],
    "modules": [
        {
            "name": "libretro-flycast",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=Release",
                "-DCMAKE_INSTALL_LIBDIR=lib",
                "-DLIBRETRO=ON",
                "-DUSE_GLES=ON",
                "-DUSE_VULKAN=OFF"
            ],
            "post-install": [
                "strip /app/lib/libretro/flycast_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/kodi-game/flycast/archive/8b8ae4caf1a5ae8c68bbe104770c28ed1ef58b6e.tar.gz",
                    "sha256": "506ffd86d0bb797bba0d5727463c8981f7ebc6217f7b8e3f47aa5e4d1aa94fe7"
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/kodi-game/game.libretro.flycast/e71b89f3f7bcf9425512a1882fe92630f170e07a/depends/common/flycast/0001-Set-version-to-0.1.0.patch",
                    "sha256": "2f19afadbe641e84d4da59ee32ad92b707ab12b22cda90b07da15786e2ff8ed7",
                    "dest-filename": "0001-Set-version-to-0.1.0.patch"
                },
                {
                    "type": "shell",
                    "commands": [
                        "patch -p1 < 0001-Set-version-to-0.1.0.patch"
                    ]
                }
            ]
        }
    ],
    "post-install": [
        "bash $FLATPAK_BUILDER_BUILDDIR/gen-addon-metainfo.sh game.libretro.flycast"
    ]
}
