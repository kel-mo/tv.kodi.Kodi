{
    "name": "game.libretro.mame2003_plus",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPACKAGE_ZIP=ON",
        "-DCMAKE_INSTALL_PREFIX=/app/lib/kodi/addons",
        "-DCMAKE_PREFIX_PATH=/app"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.mame2003_plus",
            "commit": "566d6723fa2078dfd38babf3076170cbce86d2c8"
        },
        {
            "type": "file",
            "path": "../../tools/gen-addon-metainfo.sh"
        }
    ],
    "modules": [
        {
            "name": "libretro-mame2003_plus",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "build-commands": [
                "make -j$FLATPAK_BUILDER_N_JOBS PREFIX=/app ARCH= CC=cc NATIVE_CC=cc LD=cc",
                "install -s -D -m 755 mame2003_plus_libretro.so /app/lib/libretro/mame2003_plus_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/mame2003-plus-libretro/archive/2a60eda71ae0fea543a76a43b5d58086a5485256.tar.gz",
                    "sha256": "e305bc645bef269064412c32c46836dd015e247f14da70790e8afcee7936e501"
                }
            ]
        }
    ],
    "post-install": [
        "bash $FLATPAK_BUILDER_BUILDDIR/gen-addon-metainfo.sh game.libretro.mame2003_plus"
    ]
}
