{
    "name": "game.libretro.dosbox",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPACKAGE_ZIP=ON",
        "-DCMAKE_INSTALL_PREFIX=/app/lib/kodi/addons",
        "-DCMAKE_PREFIX_PATH=/app"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.dosbox",
            "commit": "02dfb65eec3a010b49beb881f5caca5e5a7571ad"
        },
        {
            "type": "file",
            "path": "../../tools/gen-addon-metainfo.sh"
        }
    ],
    "modules": [
        {
            "name": "libretro-dosbox",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "build-commands": [
                "make -C libretro -f Makefile.libretro -j$FLATPAK_BUILDER_N_JOBS GIT_VERSION= platform=unix BUNDLED_SDL=1",
                "install -s -D -m 755 libretro/dosbox_libretro.so /app/lib/libretro/dosbox_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/dosbox-libretro/archive/a563bb5e9753f207d74e9d8c417d793b784fa4be.tar.gz",
                    "sha256": "f25821af18acd6ca6598d2366e2d0d9bf901b1111f35142d99b815b238baa44d"
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/kodi-game/game.libretro.dosbox/02dfb65eec3a010b49beb881f5caca5e5a7571ad/depends/common/dosbox/0001-Build-the-objects-after-all-bundled-deps.patch",
                    "sha256": "f94c7c923284994efbd7e99d11fee08eb469f949801073e67cfe2baece1439aa",
                    "dest-filename": "0001-Build-the-objects-after-all-bundled-deps.patch"
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/kodi-game/game.libretro.dosbox/02dfb65eec3a010b49beb881f5caca5e5a7571ad/depends/common/dosbox/0002-Touch-mpg123-s-autotools-files-before-configuring-it.patch",
                    "sha256": "0474025a0750b060a8ca14d205c609d12bcb10b3ddbd92e0070f7f507ea75a45",
                    "dest-filename": "0002-Touch-mpg123-s-autotools-files-before-configuring-it.patch"
                },
                {
                    "type": "shell",
                    "commands": [
                        "patch -p1 < 0001-Build-the-objects-after-all-bundled-deps.patch",
                        "patch -p1 < 0002-Touch-mpg123-s-autotools-files-before-configuring-it.patch"
                    ]
                }
            ]
        }
    ],
    "post-install": [
        "bash $FLATPAK_BUILDER_BUILDDIR/gen-addon-metainfo.sh game.libretro.dosbox"
    ]
}
