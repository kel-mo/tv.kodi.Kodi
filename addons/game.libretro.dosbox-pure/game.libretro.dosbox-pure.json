{
    "name": "game.libretro.dosbox-pure",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPACKAGE_ZIP=ON",
        "-DCMAKE_INSTALL_PREFIX=/app/lib/kodi/addons",
        "-DCMAKE_PREFIX_PATH=/app"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.dosbox-pure",
            "commit": "614345c09067441e273d3891220998d17158ad23"
        },
        {
            "type": "file",
            "path": "../../tools/gen-addon-metainfo.sh"
        }
    ],
    "modules": [
        {
            "name": "libretro-dosbox-pure",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0 -fPIC",
                "cxxflags": "-g0 -fPIC"
            },
            "build-commands": [
                "make -j$FLATPAK_BUILDER_N_JOBS PREFIX=/app",
                "install -s -D -m 755 dosbox_pure_libretro.so /app/lib/libretro/dosbox_pure_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/dosbox-pure/archive/e39497e7c2a32c67c26e6598dd14f6d58c384bfd.tar.gz",
                    "sha256": "2ab3a532739450563a93e5cb833cfdff72c2aedb9aa8fe543694d1fd1dfc188c"
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/kodi-game/game.libretro.dosbox-pure/614345c09067441e273d3891220998d17158ad23/depends/common/dosbox-pure/0001-Shut-down-the-core-on-explicit-top-shell-EXIT.patch",
                    "sha256": "fbcb3ed7d0e3972d8ba236da15ad0a2e06f38f1810ca79f5da229a56578410bd",
                    "dest-filename": "0001-Shut-down-the-core-on-explicit-top-shell-EXIT.patch"
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/kodi-game/game.libretro.dosbox-pure/614345c09067441e273d3891220998d17158ad23/depends/common/dosbox-pure/0003-Fix-core-reload-buffers-and-empty-disc-restoration.patch",
                    "sha256": "ed39323c6e96fd588cb473ed7e4db6220cada66953b9fdf3a9fd0a15189a0bc1",
                    "dest-filename": "0003-Fix-core-reload-buffers-and-empty-disc-restoration.patch"
                },
                {
                    "type": "shell",
                    "commands": [
                        "patch -p1 < 0001-Shut-down-the-core-on-explicit-top-shell-EXIT.patch",
                        "patch -p1 < 0003-Fix-core-reload-buffers-and-empty-disc-restoration.patch"
                    ]
                }
            ]
        }
    ],
    "post-install": [
        "bash $FLATPAK_BUILDER_BUILDDIR/gen-addon-metainfo.sh game.libretro.dosbox-pure"
    ]
}
