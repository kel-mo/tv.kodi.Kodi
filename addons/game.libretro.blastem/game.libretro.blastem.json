{
    "name": "game.libretro.blastem",
    "only_arches": [
        "x86_64"
    ],
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPACKAGE_ZIP=ON",
        "-DCMAKE_INSTALL_PREFIX=/app/lib/kodi/addons",
        "-DCMAKE_PREFIX_PATH=/app"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.blastem",
            "commit": "e990f4d6ad1b3d7fe2745357fc2bfa5477b24b18"
        }
    ],
    "modules": [
        {
            "name": "libretro-blastem",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "build-commands": [
                "make -j$FLATPAK_BUILDER_N_JOBS PREFIX=/app -f Makefile.libretro",
                "install -s -D -m 755 blastem_libretro.so /app/lib/libretro/blastem_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/blastem/archive/ec73825ece2a134beb7825a5fd6fd21a398ff12e.tar.gz",
                    "sha256": "7b8cdc6d1d9a6e0b3c459ad8d93c1fae79449e06d22c46ea020ad5cedba307c1"
                }
            ]
        }
    ]
}
