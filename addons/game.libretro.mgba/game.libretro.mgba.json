{
    "name": "game.libretro.mgba",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPACKAGE_ZIP=ON",
        "-DCMAKE_INSTALL_PREFIX=/app/lib/kodi/addons",
        "-DCMAKE_PREFIX_PATH=/app"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.mgba",
            "commit": "0a41911d383b5ef739407e3f1b8ea3e6d35bfbdf"
        },
        {
            "type": "file",
            "path": "../../tools/gen-addon-metainfo.sh"
        }
    ],
    "modules": [
        {
            "name": "libretro-mgba",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "build-commands": [
                "cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DLIBMGBA_ONLY=ON -DBUILD_LIBRETRO=ON -DSKIP_LIBRARY=ON",
                "cmake --build build --target mgba_libretro -j$FLATPAK_BUILDER_N_JOBS",
                "install -s -D -m 755 build/mgba_libretro.so /app/lib/libretro/mgba_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/mgba-emu/mgba/archive/9fcaa882f25de40258f9578480854e590db12699.tar.gz",
                    "sha256": "d03e138c25c5d88017ff304c439f9d5d2c2cff8cd34491255f9c409139f24108"
                }
            ]
        }
    ],
    "post-install": [
        "bash $FLATPAK_BUILDER_BUILDDIR/gen-addon-metainfo.sh game.libretro.mgba"
    ]
}
