The core's "Hardware (Auto)" renderer asks the frontend which context it
prefers and only opens the OpenGL renderer for desktop GL. Kodi built for
OpenGL ES prefers GLES 3, so a core built for GLES fell back to software
unless the user picked "Hardware (OpenGL)". Take the GLES contexts too
when the core is built for GLES.

--- a/rhi/rhi_intf.c
+++ b/rhi/rhi_intf.c
@@ -385,7 +385,13 @@
 #if defined(HAVE_OPENGL) || defined(HAVE_OPENGLES)
       if ((   preferred == RETRO_HW_CONTEXT_DUMMY
            || preferred == RETRO_HW_CONTEXT_OPENGL
-           || preferred == RETRO_HW_CONTEXT_OPENGL_CORE)
+           || preferred == RETRO_HW_CONTEXT_OPENGL_CORE
+#if defined(HAVE_OPENGLES)
+           || preferred == RETRO_HW_CONTEXT_OPENGLES2
+           || preferred == RETRO_HW_CONTEXT_OPENGLES3
+           || preferred == RETRO_HW_CONTEXT_OPENGLES_VERSION
+#endif
+           )
           && rhi_gl_open(is_pal))
       {
          rhi_type       = RHI_OPENGL;
