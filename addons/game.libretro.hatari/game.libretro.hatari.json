{
    "name": "game.libretro.hatari",
    "buildsystem": "cmake-ninja",
    "build-options": {
        "no-debuginfo": true,
        "cflags": "-g0",
        "cxxflags": "-g0"
    },
    "config-opts": [
        "-DCMAKE_BUILD_TYPE=Release",
        "-DPACKAGE_ZIP=ON",
        "-DCMAKE_INSTALL_PREFIX=/app/lib/kodi/addons",
        "-DCMAKE_PREFIX_PATH=/app"
    ],
    "sources": [
        {
            "type": "git",
            "url": "https://github.com/kodi-game/game.libretro.hatari",
            "commit": "0ae5cc3e5a7b1929251d37b8d901727f4ceaa2db"
        },
        {
            "type": "file",
            "path": "../../tools/gen-addon-metainfo.sh"
        }
    ],
    "modules": [
        {
            "name": "libretro-hatari",
            "buildsystem": "simple",
            "build-options": {
                "no-debuginfo": true,
                "cflags": "-g0",
                "cxxflags": "-g0"
            },
            "build-commands": [
                "cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DENABLE_HATARI=OFF -DENABLE_TOOLS=OFF -DENABLE_LIBRETRO=ON -DCMAKE_MODULE_LINKER_FLAGS=-Wl,--no-undefined -DCMAKE_C_STANDARD_LIBRARIES=-lm",
                "cmake --build build --target hatari_libretro -j$FLATPAK_BUILDER_N_JOBS",
                "install -s -D -m 755 build/src/hatari_libretro.so /app/lib/libretro/hatari_libretro.so"
            ],
            "cleanup": [
                "/lib/libretro"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/libretro/hatari/archive/4edc56f4e2add886ed5406854d12f95fdfdf67b6.tar.gz",
                    "sha256": "9cee18f9583c58356825146820e7efb7324e994ca77d34c4f9cbbfeac3238c8a"
                },
                {
                    "type": "file",
                    "url": "https://raw.githubusercontent.com/kodi-game/game.libretro.hatari/0ae5cc3e5a7b1929251d37b8d901727f4ceaa2db/depends/common/hatari/01-hatari-libretro.patch",
                    "sha256": "65ca4b4868d6f1d6d0bc466dfc6cdf8b5946002483c83f4969d2c9666ada3308",
                    "dest-filename": "01-hatari-libretro.patch"
                },
                {
                    "type": "shell",
                    "commands": [
                        "patch -p1 < 01-hatari-libretro.patch"
                    ]
                }
            ]
        }
    ],
    "post-install": [
        "bash $FLATPAK_BUILDER_BUILDDIR/gen-addon-metainfo.sh game.libretro.hatari"
    ]
}
